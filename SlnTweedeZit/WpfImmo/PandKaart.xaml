<UserControl x:Class="WpfImmo.PandKaart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Eén woningkaart in de galerij. Alle inhoud wordt in code-behind
         gevuld (geen Binding): MainWindow roept de constructor aan met het
         Pand-object, en deze UserControl vult zelf zijn eigen UI-elementen. -->
    <Grid Width="220" Margin="8" Cursor="Hand" MouseLeftButtonUp="Kaart_MouseLeftButtonUp">
        <Border x:Name="KaartBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Background="White">
            <StackPanel>
                <Image x:Name="FotoAfbeelding" Height="140" Stretch="UniformToFill"/>
                <TextBlock x:Name="AdresTekst" FontWeight="Bold" Margin="8,8,8,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="PrijsTekst" Margin="8,4,8,0"/>
                <TextBlock x:Name="EnergielabelTekst" Margin="8,2,8,8" Foreground="#555555"/>
            </StackPanel>
        </Border>

        <!-- Grijze overlay + rode "VERKOCHT"-band: enkel zichtbaar wanneer
             het pand verkocht is (zie PandKaart.xaml.cs > VulIn). -->
        <Rectangle x:Name="GrijzeOverlay" Fill="#99808080" RadiusX="6" RadiusY="6"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="VerkochtBand" Background="#DD1B1B" Visibility="Collapsed"
                VerticalAlignment="Top" Margin="0,15,0,0" Padding="4" IsHitTestVisible="False">
            <TextBlock Text="VERKOCHT" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
