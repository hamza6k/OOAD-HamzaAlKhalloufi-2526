<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CLImmo\CLImmo.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Het SQLite-databankbestand wordt meegeleverd met de app en naar de
       output directory gekopieerd, zodat de app steeds met de meegeleverde
       (test)data start. -->
  <ItemGroup>
    <None Include="Data\ImmoDB.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Alle woningfoto's + de vervangafbeelding (geen-foto.png) worden mee
       gekopieerd naar de output directory. -->
  <ItemGroup>
    <None Include="Afbeeldingen\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
