<Window x:Class="WpfImmo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfImmo"
        mc:Ignorable="d"
        Title="Immokantoor" Height="800" Width="1250" MinHeight="500" MinWidth="850"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Filterbalk bovenaan -->
        <Border Grid.Row="0" Background="#F2F2F2" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Energielabel:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="EnergielabelCombo" Width="140" Margin="0,0,24,0"
                          SelectionChanged="Filter_Gewijzigd"/>

                <TextBlock Text="Makelaar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="MakelaarCombo" Width="200" Margin="0,0,24,0"
                          SelectionChanged="Filter_Gewijzigd"/>

                <CheckBox x:Name="EnkelTeKoopCheck" Content="Enkel te koop" VerticalAlignment="Center" Margin="0,0,24,0"
                          Checked="Filter_Gewijzigd" Unchecked="Filter_Gewijzigd"/>

                <Button x:Name="NieuwPandButton" Content="Nieuw pand toevoegen" Padding="12,5"
                        Click="NieuwPandButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Hoofdinhoud: links de galerij, rechts de detailweergave -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 2. Galerij met woningkaarten -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="GalerijPanel" Margin="10"/>
            </ScrollViewer>

            <!-- 3. Detailweergave van het geselecteerde pand -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock x:Name="GeenSelectieTekst"
                                   Text="Selecteer een pand in de galerij om de details te bekijken."
                                   FontStyle="Italic" Foreground="#777777" TextWrapping="Wrap"/>

                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <Image x:Name="DetailFoto" Height="320" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="0,0,0,18"/>
                            <TextBlock x:Name="DetailInfoTekst" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                            <Button x:Name="MarkeerVerkochtButton" Content="Markeer verkocht"
                                    Margin="0,20,0,0" Padding="14,7" HorizontalAlignment="Left"
                                    Click="MarkeerVerkochtButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
